{
  "project_name": "workflow-template",
  "project_root": ".",
  "description": "Multi-agent orchestration template",
  "settings": {
    "notion_enabled": false,
    "github_enabled": true,
    "default_severity": "major",
    "default_complexity": "medium"
  },
  "models": {
    "architect": "opus",
    "planner": "sonnet",
    "execution_simple": "haiku",
    "execution_medium": "sonnet",
    "execution_complex": "opus",
    "reviewer": "sonnet",
    "integrator": "sonnet"
  },
  "paths": {
    "plans_active": "docs/plans/active",
    "plans_archive": "docs/plans/archive",
    "ai_tasks": ".agents/ai-tasks",
    "outputs": ".agents/outputs"
  },
  "ai_provider": {
    "active": "glm",
    "max_tokens": 4096,
    "temperature": 0.1,
    "providers": {
      "glm": {
        "name": "Z.AI GLM",
        "type": "api",
        "api_base": "https://api.z.ai/api/coding/paas/v4",
        "model": "GLM-4.7",
        "env_key": "ZAI_API_KEY"
      },
      "claude": {
        "name": "Claude (Anthropic)",
        "type": "anthropic",
        "api_base": "https://api.anthropic.com/v1",
        "model": "claude-sonnet-4-5-20241022",
        "env_key": "ANTHROPIC_API_KEY"
      },
      "haiku": {
        "name": "Claude Haiku",
        "type": "anthropic",
        "api_base": "https://api.anthropic.com/v1",
        "model": "claude-3-5-haiku-20241022",
        "env_key": "ANTHROPIC_API_KEY"
      },
      "sonnet": {
        "name": "Claude Sonnet",
        "type": "anthropic",
        "api_base": "https://api.anthropic.com/v1",
        "model": "claude-sonnet-4-5-20241022",
        "env_key": "ANTHROPIC_API_KEY"
      },
      "opus": {
        "name": "Claude Opus",
        "type": "anthropic",
        "api_base": "https://api.anthropic.com/v1",
        "model": "claude-opus-4-5-20251101",
        "env_key": "ANTHROPIC_API_KEY"
      },
      "codex": {
        "name": "OpenAI Codex",
        "type": "cli",
        "command": "codex exec --full-auto",
        "env_key": "OPENAI_API_KEY"
      },
      "deepseek": {
        "name": "DeepSeek",
        "type": "api",
        "api_base": "https://api.deepseek.com/v1",
        "model": "deepseek-coder",
        "env_key": "DEEPSEEK_API_KEY"
      },
      "moonshot": {
        "name": "Moonshot",
        "type": "api",
        "api_base": "https://api.moonshot.cn/v1",
        "model": "moonshot-v1-8k",
        "env_key": "MOONSHOT_API_KEY"
      }
    }
  },
  "ai_task_routing": {
    "_comment": "Maps task types to providers by complexity. Values can be string (legacy, treated as medium) or object with simple/medium/complex keys.",
    "code_execution": {
      "simple": "haiku",
      "medium": "glm",
      "complex": "sonnet"
    },
    "pr_description": {
      "simple": "haiku",
      "medium": "glm",
      "complex": "glm"
    },
    "documentation": {
      "simple": "glm",
      "medium": "glm",
      "complex": "sonnet"
    },
    "commit_message": {
      "simple": "glm",
      "medium": "glm",
      "complex": "glm"
    },
    "changelog": {
      "simple": "glm",
      "medium": "glm",
      "complex": "sonnet"
    },
    "test_generation": {
      "simple": "glm",
      "medium": "sonnet",
      "complex": "opus"
    },
    "research_summary": {
      "simple": "sonnet",
      "medium": "sonnet",
      "complex": "opus"
    },
    "error_explanation": {
      "simple": "sonnet",
      "medium": "sonnet",
      "complex": "opus"
    },
    "code_review": {
      "simple": "glm",
      "medium": "sonnet",
      "complex": "opus"
    }
  }
}
